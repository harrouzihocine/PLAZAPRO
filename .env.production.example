# Root .env template for the PRODUCTION checkout (compose-level variables).
# Do NOT fill this in by hand — run scripts/generate-prod-env.sh, which copies
# it to .env with strong random secrets and your domain. Never commit .env.

COMPOSE_PROJECT_NAME=plaza-prod
# Makes every `docker compose` command in this checkout use the prod stack.
COMPOSE_FILE=docker-compose.prod.yml

# nginx LAN/localhost ports (internet traffic arrives via the tunnel instead).
# 443 serves the office LAN over HTTPS with a real Let's Encrypt cert — see
# docs/production-runbook.md §LAN HTTPS; 80 only healthchecks and redirects.
APP_PORT=80
APP_TLS_PORT=443

MYSQL_DATABASE=plaza
MYSQL_USER=plaza
MYSQL_PASSWORD=__GENERATE__
MYSQL_ROOT_PASSWORD=__GENERATE__

REDIS_PASSWORD=__GENERATE__

# From the Cloudflare Zero Trust dashboard (Networks → Tunnels → your tunnel).
# Start the tunnel with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Split-horizon DNS for the office (docker compose --profile lan-dns up -d):
# dnsmasq answers LAN_TLS_DOMAIN with LAN_DNS_IP (this server's LAN address)
# and forwards everything else upstream. Point the router's DHCP primary DNS
# at LAN_DNS_IP. Only needed when the router itself can't map local hostnames.
LAN_TLS_DOMAIN=app.plaza-pro.com
LAN_DNS_IP=

# API token for Let's Encrypt DNS-01 (office-LAN HTTPS). Create at
# dash.cloudflare.com → My Profile → API Tokens with EXACTLY one permission:
# Zone → DNS → Edit, scoped to this site's zone only. Consumed by
# scripts/setup-lan-tls.sh + renew-lan-cert.sh (never passed to containers as
# an env var — they write it to secrets/cloudflare-dns.ini, mode 600).
CLOUDFLARE_DNS_API_TOKEN=

# Match the host user so bind-mounted files stay writable without root artefacts.
UID=1000
GID=1000
