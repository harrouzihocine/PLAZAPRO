# frontend/.env.production template — read by `vite build` (production mode).
# Created as .env.production by scripts/generate-prod-env.sh; the Reverb key is
# kept in sync with backend/.env automatically. Never commit .env.production.
#
# VITE_REVERB_HOST is intentionally ABSENT: useEcho.js then falls back to
# window.location.hostname, so one build works on the public domain and any
# LAN fallback origin alike.

VITE_APP_NAME="PLAZA PRO"
VITE_REVERB_APP_KEY=__GENERATE_REVERB_KEY__
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
