# Frontend (Vite) environment. Copy to .env to enable real-time (Phase 5).
# Without these the app still works — the notification bell and chat threads
# fall back to their HTTP fetches; only live push over websockets is disabled.

VITE_APP_NAME="PLAZA PRO"

# Laravel Echo -> Reverb (websockets). Point these at the public Reverb server.
# Defaults match backend/.env.example (Reverb on port 8081 so it doesn't clash
# with nginx on 8080). The browser connects directly to this host/port.
VITE_REVERB_APP_KEY=plaza-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http
