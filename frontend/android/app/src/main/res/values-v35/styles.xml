<?xml version="1.0" encoding="utf-8"?>
<!-- Android 15 (API 35) enforces edge-to-edge for apps targeting SDK 35, which
     silently disables windowSoftInputMode=adjustResize — the soft keyboard
     then covers the chat composer instead of shrinking the window. Opting out
     restores the pre-15 window behavior the whole web layer was designed
     against (env(safe-area-inset-*) resolving to 0 included). Revisit when
     targetSdk moves to 36: the attribute is ignored there and the WebView
     margins must come from ime() insets instead (Capacitor
     adjustMarginsForEdgeToEdge handles system bars, but not the keyboard). -->
<resources>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
