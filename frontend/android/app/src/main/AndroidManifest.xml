<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:screenOrientation="userPortrait"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM receiver: system-tray push with deep links (PlazaPush). Builds
             without google-services.json compile fine — push just stays off. -->
        <service
            android:name=".PlazaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Inline "Reply" on chat notifications (RemoteInput → backend). -->
        <receiver
            android:name=".ReplyReceiver"
            android:exported="false" />

        <!-- On-duty location share (My Day's duty switch): a foreground service
             with the mandated ongoing notification, posting throttled fixes to
             /me/positions over the WebView session. Never self-starts. -->
        <service
            android:name=".DutyLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Click-to-call trampoline: notification tap → default dialer with
             the number pre-filled + the "dialed" report to the backend. An
             invisible activity (Theme.NoDisplay) — Android 12+ forbids
             notification trampolines through receivers/services. -->
        <activity
            android:name=".CallTrampolineActivity"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- On-duty location share: runtime-prompted when the duty switch first
         flips on; the foreground service type is mandatory from Android 14. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- System-tray push (Android 13+ runtime prompt — MainActivity asks). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Webview media: photo capture from <input type="file"> (unit/client media
         uploads) and getUserMedia for chat voice notes (VoiceRecorder.vue).
         Capacitor's WebChromeClient requests these at runtime when the page
         first uses them; neither is required hardware to install. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- navigator.vibrate() in the WebView: the swipe-to-reply haptic tick. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
