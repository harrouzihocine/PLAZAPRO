# backend/.env template for PRODUCTION.
# Do NOT fill this in by hand — run scripts/generate-prod-env.sh (it fills the
# placeholders and keeps DB/Redis/Reverb values in sync with the root .env and
# the frontend). APP_KEY is created by scripts/deploy.sh on first deploy.
# Never commit .env.

APP_NAME="PLAZA PRO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__DOMAIN__

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Rotated daily, 30 days kept; INFO keeps the signal (auth, jobs) without debug noise.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=plaza
DB_USERNAME=plaza
DB_PASSWORD=__GENERATE_DB__

# Sessions survive Redis restarts; cookies only ever travel over HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=plaza
REVERB_APP_KEY=__GENERATE_REVERB_KEY__
REVERB_APP_SECRET=__GENERATE__
# Server-side publishing goes straight to the reverb container on the docker
# network; browsers connect via wss://__DOMAIN__/app (nginx proxy).
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http
# Hostnames (not URLs) allowed to open a websocket; Str::is patterns.
REVERB_ALLOWED_ORIGINS=__DOMAIN__

FILESYSTEM_DISK=local

# Redis queue: atomic, no cache-table deadlocks, survives restarts (AOF).
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=__GENERATE_REDIS__
REDIS_PORT=6379

# In-app notifications are the primary channel; point this at a real SMTP
# provider the day outbound e-mail matters.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@__DOMAIN__"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=https://__DOMAIN__
SANCTUM_STATEFUL_DOMAINS=__DOMAIN__
