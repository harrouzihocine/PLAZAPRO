APP_NAME="PLAZA PRO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Algiers
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL — service name "mysql" inside the Docker network
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=plaza
DB_USERNAME=root
DB_PASSWORD=secret

# Sanctum SPA (cookie) auth — first-party frontend
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8080
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Real-time (Phase 5). Live notifications + chat broadcast over Laravel Reverb
# (websockets). Runs as its own process/container: `php artisan reverb:start`
# in dev, a `reverb` service in prod (Phase 7). Broadcasts are queued.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=plaza
REVERB_APP_KEY=plaza-key
REVERB_APP_SECRET=plaza-secret
# Where server-side broadcasting reaches Reverb. In Docker this is the service
# name (REVERB_HOST=reverb); for a host run use localhost. Reverb listens on 8081
# so it doesn't clash with nginx on 8080.
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
# What the browser (Echo) connects to — the public host/port of the Reverb server.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (dev) — catches outgoing mail at http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@plaza.local"
MAIL_FROM_NAME="${APP_NAME}"

# Media (Phase 2). Private disk driver: 'local' in dev, 's3' for object storage
# in prod. Files are served through a permission-gated endpoint, never public.
MEDIA_DRIVER=local
# LibreOffice headless binary used to render PPTX -> PDF for inline preview
# (installed in the queue-worker container).
SOFFICE_BIN=soffice

# Object storage for media (prod) — used when MEDIA_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Documents (Phase 4). Generated PDFs (receipts/contracts) on a private disk —
# 'local' in dev, 's3' in prod. Served only through a permission-gated endpoint.
DOCUMENTS_DRIVER=local
# Chat attachments (Phase 5): images/voice notes/files on a private disk —
# 'local' in dev, 's3' in prod. Served only through a participant-gated endpoint.
CHAT_DRIVER=local
# Branding stamped onto generated documents.
COMPANY_NAME="PLAZA PRO"
COMPANY_TAGLINE="Real Estate"
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_CURRENCY=DZD

VITE_APP_NAME="${APP_NAME}"
